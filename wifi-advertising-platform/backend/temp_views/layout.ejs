<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WiFi Advertising Platform | <%= typeof title !== 'undefined' ? title : 'Dashboard' %></title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daisyui@3.0.0/dist/full.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tailwindcss@3.0.0/dist/tailwind.min.css">
    <link rel="stylesheet" href="/static/css/style.css">
</head>
<body class="min-h-screen bg-gray-100">
    <% if (typeof user !== 'undefined') { %>
        <div class="drawer lg:drawer-open">
            <input id="drawer-toggle" type="checkbox" class="drawer-toggle" />
            <div class="drawer-content flex flex-col">
                <!-- Navbar -->
                <div class="navbar bg-base-300">
                    <div class="flex-none lg:hidden">
                        <label for="drawer-toggle" class="btn btn-square btn-ghost">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block w-6 h-6 stroke-current">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                            </svg>
                        </label>
                    </div>
                    <div class="flex-1">
                        <span class="text-xl font-bold">WiFi Advertising Platform</span>
                    </div>
                    <div class="flex-none">
                        <div class="dropdown dropdown-end">
                            <label tabindex="0" class="btn btn-ghost btn-circle avatar">
                                <div class="w-10 rounded-full bg-primary">
                                    <span class="text-center flex items-center justify-center h-full text-white">
                                        <%= user.first_name ? user.first_name.charAt(0) : user.email.charAt(0) %>
                                    </span>
                                </div>
                            </label>
                            <ul tabindex="0" class="menu menu-sm dropdown-content mt-3 z-[1] p-2 shadow bg-base-100 rounded-box w-52">
                                <li><a>Profile</a></li>
                                <li><a>Settings</a></li>
                                <li><a href="/logout">Logout</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
                
                <!-- Page content -->
                <main class="flex-1 p-6">
                    <%- body %>
                </main>
            </div>
            
            <!-- Sidebar -->
            <div class="drawer-side">
                <label for="drawer-toggle" class="drawer-overlay"></label>
                <ul class="menu p-4 w-60 h-full bg-base-200 text-base-content">
                    <li class="mb-2">
                        <h2 class="menu-title text-primary font-bold">
                            <%= user.role.charAt(0).toUpperCase() + user.role.slice(1) %> Dashboard
                        </h2>
                    </li>
                    <% if (user.role === 'admin') { %>
                        <li><a href="/admin/dashboard.ejs" class="<%= path === '/admin/dashboard' ? 'active' : '' %>">Dashboard</a></li>
                        <li><a href="/admin/users" class="<%= path === '/admin/users' ? 'active' : '' %>">User Management</a></li>
                        <li><a href="/admin/transactions" class="<%= path === '/admin/transactions' ? 'active' : '' %>">Transactions</a></li>
                        <li><a href="/admin/reports" class="<%= path === '/admin/reports' ? 'active' : '' %>">Reports</a></li>
                        <li><a href="/admin/settings" class="<%= path === '/admin/settings' ? 'active' : '' %>">System Settings</a></li>
                    <% } else if (user.role === 'agent') { %>
                        <li><a href="/agent/dashboard" class="<%= path === '/agent/dashboard' ? 'active' : '' %>">Dashboard</a></li>
                        <li><a href="/agent/merchants" class="<%= path === '/agent/merchants' ? 'active' : '' %>">Merchants</a></li>
                        <li><a href="/agent/qrcodes" class="<%= path === '/agent/qrcodes' ? 'active' : '' %>">QR Codes</a></li>
                        <li><a href="/agent/commissions" class="<%= path === '/agent/commissions' ? 'active' : '' %>">Commissions</a></li>
                        <li><a href="/agent/profile" class="<%= path === '/agent/profile' ? 'active' : '' %>">Profile</a></li>
                    <% } else if (user.role === 'advertiser') { %>
                        <li><a href="/advertiser/dashboard" class="<%= path === '/advertiser/dashboard' ? 'active' : '' %>">Dashboard</a></li>
                        <li><a href="/advertiser/campaigns" class="<%= path === '/advertiser/campaigns' ? 'active' : '' %>">Campaigns</a></li>
                        <li><a href="/advertiser/analytics" class="<%= path === '/advertiser/analytics' ? 'active' : '' %>">Analytics</a></li>
                        <li><a href="/advertiser/budget" class="<%= path === '/advertiser/budget' ? 'active' : '' %>">Budget</a></li>
                        <li><a href="/advertiser/profile" class="<%= path === '/advertiser/profile' ? 'active' : '' %>">Profile</a></li>
                    <% } else if (user.role === 'merchant') { %>
                        <li><a href="/merchant/dashboard" class="<%= path === '/merchant/dashboard' ? 'active' : '' %>">Dashboard</a></li>
                        <li><a href="/merchant/wifi" class="<%= path === '/merchant/wifi' ? 'active' : '' %>">WiFi Settings</a></li>
                        <li><a href="/merchant/earnings" class="<%= path === '/merchant/earnings' ? 'active' : '' %>">Earnings</a></li>
                        <li><a href="/merchant/profile" class="<%= path === '/merchant/profile' ? 'active' : '' %>">Profile</a></li>
                    <% } %>
                </ul>
            </div>
        </div>
    <% } else { %>
        <%- body %>
    <% } %>
    
    <script>
        // Add any required JavaScript here
        document.addEventListener('DOMContentLoaded', function() {
            // Example of getting URL path for sidebar active state
            const path = window.location.pathname;
            // This would be used by the layout to highlight the active sidebar item
        });
    </script>
</body>
</html>