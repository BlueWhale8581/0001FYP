<%- include('layout', { path: '/admin/reports' }) %>

<div class="container mx-auto">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold">System Reports</h1>
        <div class="flex gap-2">
            <div class="dropdown dropdown-end">
                <label tabindex="0" class="btn btn-primary">Generate Report</label>
                <ul tabindex="0" class="dropdown-content menu p-2 shadow bg-base-100 rounded-box w-52">
                    <li><a href="#" onclick="generateReport('revenue')">Revenue Report</a></li>
                    <li><a href="#" onclick="generateReport('adPerformance')">Ad Performance</a></li>
                    <li><a href="#" onclick="generateReport('wifiUsage')">WiFi Usage</a></li>
                    <li><a href="#" onclick="generateReport('agent')">Agent Performance</a></li>
                    <li><a href="#" onclick="generateReport('system')">System Summary</a></li>
                </ul>
            </div>
            <button class="btn btn-outline btn-primary" id="exportBtn">Export</button>
        </div>
    </div>

    <!-- Filters Section -->
    <div class="bg-base-200 p-4 rounded-lg mb-6">
        <div class="flex flex-wrap gap-4 items-end">
            <div class="form-control">
                <label class="label">
                    <span class="label-text">Report Type</span>
                </label>
                <select class="select select-bordered w-full max-w-xs" id="reportType">
                    <option value="all" selected>All Reports</option>
                    <option value="revenue">Revenue Reports</option>
                    <option value="adPerformance">Ad Performance</option>
                    <option value="wifiUsage">WiFi Usage</option>
                    <option value="agent">Agent Performance</option>
                    <option value="system">System Summary</option>
                </select>
            </div>
            <div class="form-control">
                <label class="label">
                    <span class="label-text">Date Range</span>
                </label>
                <div class="flex gap-2">
                    <input type="date" class="input input-bordered" id="startDate">
                    <span class="self-center">to</span>
                    <input type="date" class="input input-bordered" id="endDate">
                </div>
            </div>
            <div class="form-control">
                <button class="btn btn-primary" id="filterBtn">Apply Filters</button>
            </div>
        </div>
    </div>

    <!-- Reports List -->
    <div class="bg-white rounded-lg shadow">
        <div class="overflow-x-auto">
            <table class="table w-full">
                <thead>
                    <tr>
                        <th>Report ID</th>
                        <th>Report Type</th>
                        <th>Generated Date</th>
                        <th>Time Period</th>
                        <th>Generated By</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (reports && reports.length > 0) { %>
                        <% reports.forEach(report => { %>
                            <tr>
                                <td><%= report.id %></td>
                                <td><span class="badge 
                                    <%= report.type === 'revenue' ? 'badge-primary' : 
                                       report.type === 'adPerformance' ? 'badge-secondary' : 
                                       report.type === 'wifiUsage' ? 'badge-accent' : 
                                       report.type === 'agent' ? 'badge-info' : 'badge-success' %>">
                                    <%= report.type %>
                                </span></td>
                                <td><%= new Date(report.generated_at).toLocaleDateString() %></td>
                                <td><%= report.period_start %> - <%= report.period_end %></td>
                                <td><%= report.generated_by %></td>
                                <td>
                                    <div class="flex gap-2">
                                        <a href="/admin/reports/view/<%= report.id %>" class="btn btn-sm btn-outline">View</a>
                                        <a href="/admin/reports/download/<%= report.id %>" class="btn btn-sm">Download</a>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="6" class="text-center py-4">
                                <div class="alert alert-info shadow-lg">
                                    <div>
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current flex-shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                        <span>No reports found. Generate a new report to get started.</span>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    <% if (reports && reports.length > 0) { %>
        <div class="flex justify-center mt-6">
            <div class="btn-group">
                <button class="btn">«</button>
                <button class="btn">Page 1</button>
                <button class="btn">»</button>
            </div>
        </div>
    <% } %>

    <!-- Report Generation Modal -->
    <div id="reportModal" class="modal">
        <div class="modal-box">
            <h3 class="font-bold text-lg" id="modalTitle">Generate Report</h3>
            <div class="py-4">
                <div class="form-control">
                    <label class="label">
                        <span class="label-text">Report Period</span>
                    </label>
                    <div class="flex gap-2">
                        <input type="date" class="input input-bordered w-full" id="modalStartDate">
                        <span class="self-center">to</span>
                        <input type="date" class="input input-bordered w-full" id="modalEndDate">
                    </div>
                </div>
                <div class="form-control mt-4">
                    <label class="label">
                        <span class="label-text">Additional Options</span>
                    </label>
                    <div id="reportOptions">
                        <!-- Dynamic options will be inserted here based on report type -->
                    </div>
                </div>
            </div>
            <div class="modal-action">
                <button class="btn btn-outline" onclick="closeModal()">Cancel</button>
                <button class="btn btn-primary" id="generateBtn">Generate</button>
            </div>
        </div>
    </div>
</div>

<script>
    // Set today and 30 days ago as default date range
    document.addEventListener('DOMContentLoaded', function() {
        const today = new Date();
        const thirtyDaysAgo = new Date();
        thirtyDaysAgo.setDate(today.getDate() - 30);
        
        document.getElementById('endDate').valueAsDate = today;
        document.getElementById('startDate').valueAsDate = thirtyDaysAgo;
        document.getElementById('modalEndDate').valueAsDate = today;
        document.getElementById('modalStartDate').valueAsDate = thirtyDaysAgo;
    });

    function generateReport(type) {
        const modal = document.getElementById('reportModal');
        const title = document.getElementById('modalTitle');
        const options = document.getElementById('reportOptions');
        
        // Set title based on report type
        title.textContent = `Generate ${type.charAt(0).toUpperCase() + type.slice(1)} Report`;
        
        // Clear previous options
        options.innerHTML = '';
        
        // Add specific options based on report type
        switch(type) {
            case 'revenue':
                options.innerHTML = `
                    <select class="select select-bordered w-full">
                        <option value="all">All Revenue Sources</option>
                        <option value="advertiser">Advertiser Payments</option>
                        <option value="merchant">Merchant Revenue</option>
                        <option value="agent">Agent Commissions</option>
                    </select>
                `;
                break;
            case 'adPerformance':
                options.innerHTML = `
                    <select class="select select-bordered w-full">
                        <option value="all">All Campaigns</option>
                        <option value="active">Active Campaigns</option>
                        <option value="completed">Completed Campaigns</option>
                    </select>
                    <div class="flex gap-2 mt-4">
                        <input type="checkbox" class="checkbox" id="includeImpressions" checked>
                        <label for="includeImpressions">Include Impressions</label>
                    </div>
                    <div class="flex gap-2 mt-2">
                        <input type="checkbox" class="checkbox" id="includeConversions" checked>
                        <label for="includeConversions">Include Ad Completions</label>
                    </div>
                `;
                break;
            case 'wifiUsage':
                options.innerHTML = `
                    <select class="select select-bordered w-full">
                        <option value="all">All Merchants</option>
                        <option value="active">Active Merchants</option>
                    </select>
                    <div class="flex gap-2 mt-4">
                        <input type="checkbox" class="checkbox" id="includeSessionData" checked>
                        <label for="includeSessionData">Include Session Data</label>
                    </div>
                `;
                break;
            case 'agent':
                options.innerHTML = `
                    <select class="select select-bordered w-full">
                        <option value="all">All Agents</option>
                        <option value="top">Top Performing Agents</option>
                    </select>
                    <div class="flex gap-2 mt-4">
                        <input type="checkbox" class="checkbox" id="includeMerchants" checked>
                        <label for="includeMerchants">Include Merchant Details</label>
                    </div>
                `;
                break;
            case 'system':
                options.innerHTML = `
                    <div class="flex gap-2">
                        <input type="checkbox" class="checkbox" id="includeUsers" checked>
                        <label for="includeUsers">Include User Growth</label>
                    </div>
                    <div class="flex gap-2 mt-2">
                        <input type="checkbox" class="checkbox" id="includeRevenue" checked>
                        <label for="includeRevenue">Include Revenue Data</label>
                    </div>
                    <div class="flex gap-2 mt-2">
                        <input type="checkbox" class="checkbox" id="includeUsage" checked>
                        <label for="includeUsage">Include Usage Statistics</label>
                    </div>
                `;
                break;
        }
        
        // Store the report type for use when generating
        document.getElementById('generateBtn').dataset.type = type;
        
        // Show modal
        modal.classList.add('modal-open');
    }

    function closeModal() {
        document.getElementById('reportModal').classList.remove('modal-open');
    }

    // Generate button action
    document.getElementById('generateBtn').addEventListener('click', function() {
        // Get the report type from data attribute
        const reportType = this.dataset.type;
        const startDate = document.getElementById('modalStartDate').value;
        const endDate = document.getElementById('modalEndDate').value;
        
        // Show generating feedback
        this.textContent = 'Generating...';
        this.disabled = true;
        
        // Simulate API call
        setTimeout(() => {
            // Close modal
            closeModal();
            
            // Refresh page (in a real app, you'd update the table without reload)
            window.location.reload();
        }, 1500);
    });

    // Filter button action
    document.getElementById('filterBtn').addEventListener('click', function() {
        // In a real application, this would submit the filter form
        this.classList.add('loading');
        
        // Simulate API call
        setTimeout(() => {
            this.classList.remove('loading');
            // In a real app, update the table without reload
        }, 1000);
    });
</script>