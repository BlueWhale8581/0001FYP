<% layout('../layout') -%>
<% path = '/admin/dashboard' %>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <div class="stat bg-base-100 shadow">
        <div class="stat-figure text-primary">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block w-8 h-8 stroke-current">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 00-3-3.87m-4-12a4 4 0 010 7.75"></path>
            </svg>
        </div>
        <div class="stat-title">Total Users</div>
        <div class="stat-value text-primary"><%= data.userStats.total || 0 %></div>
        <div class="stat-desc">
            <span class="<%= data.userStats.growth >= 0 ? 'text-success' : 'text-error' %>">
                <%= data.userStats.growth >= 0 ? '↗︎' : '↘︎' %> <%= Math.abs(data.userStats.growth) %>%
            </span> since last month
        </div>
    </div>
    
    <div class="stat bg-base-100 shadow">
        <div class="stat-figure text-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block w-8 h-8 stroke-current">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
        </div>
        <div class="stat-title">Active Merchants</div>
        <div class="stat-value text-secondary"><%= data.merchantStats.active || 0 %></div>
        <div class="stat-desc">
            <span class="<%= data.merchantStats.growth >= 0 ? 'text-success' : 'text-error' %>">
                <%= data.merchantStats.growth >= 0 ? '↗︎' : '↘︎' %> <%= Math.abs(data.merchantStats.growth) %>%
            </span> since last month
        </div>
    </div>
    
    <div class="stat bg-base-100 shadow">
        <div class="stat-figure text-accent">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block w-8 h-8 stroke-current">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path>
            </svg>
        </div>
        <div class="stat-title">WiFi Connections</div>
        <div class="stat-value text-accent"><%= data.wifiStats.connections || 0 %></div>
        <div class="stat-desc">
            <span class="<%= data.wifiStats.growth >= 0 ? 'text-success' : 'text-error' %>">
                <%= data.wifiStats.growth >= 0 ? '↗︎' : '↘︎' %> <%= Math.abs(data.wifiStats.growth) %>%
            </span> since yesterday
        </div>
    </div>
    
    <div class="stat bg-base-100 shadow">
        <div class="stat-figure text-info">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block w-8 h-8 stroke-current">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"></path>
            </svg>
        </div>
        <div class="stat-title">Revenue (MTD)</div>
        <div class="stat-value text-info">$<%= data.revenueStats.mtd.toFixed(2) || '0.00' %></div>
        <div class="stat-desc">
            <span class="<%= data.revenueStats.growth >= 0 ? 'text-success' : 'text-error' %>">
                <%= data.revenueStats.growth >= 0 ? '↗︎' : '↘︎' %> <%= Math.abs(data.revenueStats.growth) %>%
            </span> since last month
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
    <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
            <h2 class="card-title">Active Campaigns</h2>
            <div class="overflow-x-auto">
                <table class="table w-full">
                    <thead>
                        <tr>
                            <th>Campaign</th>
                            <th>Advertiser</th>
                            <th>Budget</th>
                            <th>Spent</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (data.campaigns && data.campaigns.length > 0) { %>
                            <% data.campaigns.forEach(campaign => { %>
                                <tr>
                                    <td><%= campaign.name %></td>
                                    <td><%= campaign.advertiser %></td>
                                    <td>$<%= campaign.budget.toFixed(2) %></td>
                                    <td>$<%= campaign.spent.toFixed(2) %></td>
                                    <td>
                                        <% if (campaign.status === 'active') { %>
                                            <div class="badge badge-success">Active</div>
                                        <% } else if (campaign.status === 'paused') { %>
                                            <div class="badge badge-warning">Paused</div>
                                        <% } else { %>
                                            <div class="badge badge-info"><%= campaign.status %></div>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="text-center">No active campaigns</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
            <div class="card-actions justify-end mt-4">
                <a href="/admin/campaigns" class="btn btn-primary btn-sm">View All</a>
            </div>
        </div>
    </div>
    
    <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
            <h2 class="card-title">Recent Transactions</h2>
            <div class="overflow-x-auto">
                <table class="table w-full">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Type</th>
                            <th>Amount</th>
                            <th>Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (data.transactions && data.transactions.length > 0) { %>
                            <% data.transactions.forEach(transaction => { %>
                                <tr>
                                    <td><%= transaction.id %></td>
                                    <td><%= transaction.type %></td>
                                    <td>$<%= transaction.amount.toFixed(2) %></td>
                                    <td><%= new Date(transaction.created_at).toLocaleDateString() %></td>
                                    <td>
                                        <% if (transaction.status === 'completed') { %>
                                            <div class="badge badge-success">Completed</div>
                                        <% } else if (transaction.status === 'pending') { %>
                                            <div class="badge badge-warning">Pending</div>
                                        <% } else if (transaction.status === 'failed') { %>
                                            <div class="badge badge-error">Failed</div>
                                        <% } else { %>
                                            <div class="badge"><%= transaction.status %></div>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="text-center">No recent transactions</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
            <div class="card-actions justify-end mt-4">
                <a href="/admin/transactions" class="btn btn-primary btn-sm">View All</a>
            </div>
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
    <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
            <h2 class="card-title">Pending Approvals</h2>
            <div class="overflow-x-auto">
                <table class="table w-full">
                    <thead>
                        <tr>
                            <th>Business</th>
                            <th>Contact</th>
                            <th>Agent</th>
                            <th>Submitted</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (data.pendingApprovals && data.pendingApprovals.length > 0) { %>
                            <% data.pendingApprovals.forEach(merchant => { %>
                                <tr>
                                    <td><%= merchant.business_name %></td>
                                    <td><%= merchant.business_email %></td>
                                    <td><%= merchant.agent_name %></td>
                                    <td><%= new Date(merchant.created_at).toLocaleDateString() %></td>
                                    <td>
                                        <div class="flex space-x-1">
                                            <a href="/admin/merchants/<%= merchant.id %>" class="btn btn-xs btn-outline">Review</a>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="text-center">No pending approvals</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
            <div class="card-actions justify-end mt-4">
                <a href="/admin/merchants?status=pending" class="btn btn-primary btn-sm">View All</a>
            </div>
        </div>
    </div>
    
    <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
            <h2 class="card-title">Recent Activities</h2>
            <div class="overflow-x-auto">
                <table class="table w-full">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Action</th>
                            <th>Entity</th>
                            <th>Time</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (data.recentActivities && data.recentActivities.length > 0) { %>
                            <% data.recentActivities.forEach(activity => { %>
                                <tr>
                                    <td><%= activity.username %></td>
                                    <td><%= activity.action %></td>
                                    <td><%= activity.entity_type %> #<%= activity.entity_id %></td>
                                    <td><%= new Date(activity.created_at).toLocaleString() %></td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="4" class="text-center">No recent activities</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
            <div class="card-actions justify-end mt-4">
                <a href="/admin/audit-logs" class="btn btn-primary btn-sm">View All</a>
            </div>
        </div>
    </div>
</div>